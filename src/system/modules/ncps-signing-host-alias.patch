+// Set by the distribution when both public hostnames serve the same cache.
+var signingHostAlias string
+
+func (s *Server) aliasKeyName(name string) string {
+	version, ok := strings.CutPrefix(name, s.cache.GetHostname()+"-")
+	if !ok || version == "" || signingHostAlias == "" || signingHostAlias == s.cache.GetHostname() {
+		return ""
+	}
+
+	return signingHostAlias + "-" + version
+}
+
+func (s *Server) publicIdentity(r *http.Request) (string, signature.PublicKey) {
+	key := s.cache.PublicKey()
+	host, _, _ := strings.Cut(r.Host, ":")
+	if alias := s.aliasKeyName(key.Name); alias != "" && strings.EqualFold(host, signingHostAlias) {
+		key.Name = alias
+		return signingHostAlias, key
+	}
+
+	return s.cache.GetHostname(), key
+}
+
